MBI_ENV=development
MBI_DATABASE_URL=postgresql+psycopg://mbi:mbi@postgres:5432/mbi
MBI_REDIS_URL=redis://redis:6379/0
MBI_OBJECT_STORE_ROOT=/data
MBI_ASSET_PACK_PATH=/assets/minecraft.zip
MBI_MAX_UPLOAD_BYTES=536870912
MBI_MAX_DECOMPRESSED_BYTES=2147483648
MBI_DEMO_INLINE_JOBS=false
MBI_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

MBI_RENDERER_SERVICE_URL=http://localhost:8090
MBI_RENDERER_TIMEOUT_SECONDS=180
MBI_ARTIFACT_SIGNING_SECRET=replace-with-at-least-32-random-bytes
MBI_ARTIFACT_URL_TTL_SECONDS=900
MBI_UPLOAD_RETENTION_DAYS=7
MBI_SNAPSHOT_RETENTION_DAYS=30
MBI_EXPORT_RETENTION_DAYS=30
