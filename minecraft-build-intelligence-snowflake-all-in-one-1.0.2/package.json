{
  "name": "minecraft-build-intelligence",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "workspaces": ["apps/web", "apps/renderer-service", "packages/*"],
  "scripts": {
    "dev": "pnpm --parallel --filter @mbi/web --filter @mbi/renderer-service dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:web": "pnpm -r test"
  },
  "engines": {"node": ">=22.12.0"}
}
